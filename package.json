{
  "name": "redline-monorepo",
  "private": true,
  "type": "module",
  "workspaces": [
    "packages/*",
    "apps/*"
  ],
  "scripts": {
    "build": "npm run build -w @vvedantb/redline && npm run build -w redline-demo && npm run build -w redline-landing",
    "lint:tests": "node scripts/check-no-source-text-tests.mjs",
    "test": "npm test -w @vvedantb/redline",
    "test:e2e": "npm run build -w @vvedantb/redline && playwright test",
    "dev": "npm run build -w @vvedantb/redline && npm run dev -w redline-demo",
    "typecheck": "npm run typecheck -w @vvedantb/redline && npm run typecheck -w redline-demo && npm run typecheck -w redline-landing",
    "dev:landing": "npm run dev -w redline-landing",
    "test:compare": "npm run build -w @vvedantb/redline && node scripts/compare-e2e.mjs",
    "test:pr-diff": "npm run build -w @vvedantb/redline && node scripts/pr-diff-e2e.mjs",
    "changeset": "changeset",
    "version-packages": "changeset version",
    "release": "node scripts/release-publish.mjs"
  },
  "devDependencies": {
    "@changesets/changelog-github": "^1.0.1",
    "@changesets/cli": "^3.0.3",
    "@playwright/test": "^1.55.0",
    "@types/node": "^22.15.0",
    "next": "^16.3.8",
    "react-router-dom": "^7.18.4",
    "typescript": "^5.8.3"
  }
}
